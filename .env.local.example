# ── Required ────────────────────────────────────────────────────────────────────

# Anthropic — get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Firecrawl — get yours at https://firecrawl.dev/
FIRECRAWL_API_KEY=

# Resend — get yours at https://resend.com/
RESEND_API_KEY=
# The "from" address for scan report emails (must match a verified Resend domain)
RESEND_FROM_EMAIL=reports@yourdomain.com

# PostgreSQL connection string — works with Vercel Postgres, Supabase, Railway, etc.
# Vercel Postgres: copy "POSTGRES_URL" from your Vercel dashboard and rename it here
DATABASE_URL=

# ── App ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── Admin panel ──────────────────────────────────────────────────────────────────
# Password to access /admin — leave blank to allow open access (local dev only)
ADMIN_PASSWORD=

# ── Optional ─────────────────────────────────────────────────────────────────────
# Calendly link shown in the upsell CTA (leave blank to hide the button)
NEXT_PUBLIC_CALENDLY_URL=
